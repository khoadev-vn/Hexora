{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🛡️ Hexora: Quick Scan Workspace",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/bin/hexora.js",
        "."
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "👁️ Hexora: Real-time Watcher (Auto on Save)",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/bin/hexora.js",
        "watch"
      ],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}